{
  "name": "orderbook-replay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite --port 5173 --strictPort",
    "dev:electron": "cross-env NODE_ENV=development ELECTRON_ENABLE_LOGGING=1 ELECTRON_ENABLE_STACK_DUMPING=1 VITE_DEV_SERVER_URL=http://localhost:5173 wait-on http://localhost:5173 && electron .",
    "build": "vite build",
    "build:rust": "cd native && npm install && npm run build && cd ..",
    "setup:rust": "npm run build:rust",
    "start": "cross-env NODE_ENV=production electron .",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.5",
    "electron": "^30.0.1",
    "parquetjs-lite": "^0.8.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^7.2.0"
  }
}
